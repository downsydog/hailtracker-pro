SECRET_KEY=change-me-to-a-random-string
SKIP_HEAVY_ML=true
DEV_MODE=false

# MRMS National MESH Backbone
ENABLE_MRMS=false
MRMS_REFRESH_SECONDS=120
MRMS_PROVIDER=aws

# Database (sqlite default, postgres for production)
DATABASE_URL=sqlite:///database/hailtracker_pro.db
# DATABASE_URL=postgresql://hailtracker:hailtracker_dev@localhost:5432/hailtracker
DB_POOL_MIN=2
DB_POOL_MAX=10

# Observability
LOG_FORMAT=text
# LOG_FORMAT=json

# Security
RATE_LIMIT_DEFAULT=60/minute
CORS_ORIGINS=*

# National cadence defaults (StormMonitor)
# All optional — if absent, sane national defaults are used.
# STORM_ENABLE_DF=true
# STORM_MAX_WORKERS=24
# STORM_DISCOVERY_BATCH=80
# STORM_DISCOVERY_INTERVAL=300
# STORM_FOCUS_INTERVAL=180
# STORM_TIMEOUT_SECONDS=60
# STORM_MAX_FOCUS_RADARS=100
# STORM_HOT_TTL_SECONDS=2400
